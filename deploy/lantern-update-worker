#!/bin/bash
# Run from ec2-user's shell on the Lightsail host.
set -euo pipefail
umask 077

if [[ $(id -un) != ec2-user || $# -gt 1 || ( $# == 1 && ! $1 =~ ^[0-9a-f]{40}$ ) ]]; then
    echo "Usage (as ec2-user): lantern-update-worker [expected-full-main-SHA]" >&2
    exit 2
fi

state=/home/ec2-user/.local/state/lantern-deploy
origin=https://github.com/mikepfrank/lantern-agent.git
unit=lantern-chat.service
install -d -m 0700 "$state"
exec 9>"$state/update.lock"
flock -n 9 || { echo "Another worker update is in progress." >&2; exit 1; }
stage=$(mktemp -d "$state/stage.XXXXXXXX")
trap 'rm -rf -- "$stage"' EXIT

git init --bare -q --template= "$stage/repo"
git -C "$stage/repo" fetch -q --depth=1 --no-tags "$origin" refs/heads/main
revision=$(git -C "$stage/repo" rev-parse --verify 'FETCH_HEAD^{commit}')
echo "Fetched origin/main at $revision"
if [[ $# == 1 && $1 != "$revision" ]]; then
    echo "Expected $1. Origin has moved; review the new revision before deploying." >&2
    exit 1
fi

release=/opt/lantern/releases/$revision
running_target() {
    local pid
    systemctl is-active --quiet "$unit" || return 1
    [[ $(readlink -f /opt/lantern/worker-current) == "$release" ]] || return 1
    pid=$(systemctl show "$unit" -p MainPID --value)
    [[ $pid =~ ^[1-9][0-9]*$ ]] || return 1
    sudo -n grep -Fzxq -- "$release/lantern.pyz" "/proc/$pid/cmdline"
}
if running_target; then
    echo "Worker already running $revision."
    exit 0
fi

git -C "$stage/repo" archive --format=tar -o "$stage/source.tar" "$revision"
sha256sum "$stage/source.tar"
mkdir -m 0755 "$stage/src"
(umask 022; tar --no-same-owner -xf "$stage/source.tar" -C "$stage/src")

# Run the source tests with a private temporary home and loopback network.
sudo -n systemd-run --quiet --wait --pipe --collect \
    -p DynamicUser=yes -p PrivateTmp=yes -p PrivateNetwork=yes -p ProtectHome=yes \
    -p ProtectSystem=strict -p NoNewPrivileges=yes \
    -p "BindReadOnlyPaths=$stage/src:/run/lantern-update-source" \
    -p WorkingDirectory=/run/lantern-update-source \
    --setenv=HOME=/tmp --setenv=PYTHONDONTWRITEBYTECODE=1 \
    --setenv=LANTERN_TEST_CODEX=1 --setenv=LANTERN_CODEX_BIN=/opt/lantern/runtime/codex-0.169.0/bin/codex \
    /usr/bin/python3.12 -m unittest discover -s tests

sudo -n bash "$stage/src/deploy/install.sh" --worker-only "$revision"
for attempt in {1..10}; do
    if running_target; then
        echo "Verified running worker $revision."
        exit 0
    fi
    sleep 1
done
echo "Could not verify the running worker release." >&2
exit 1
